# Managed by dotfiles: common/apps/git/.gitconfig, copied to ~/.gitconfig by
# setup.sh. Keep this first line: it is how setup tells this copy from a
# machine's own ~/.gitconfig. Before replacing ~/.gitconfig, setup moves
# whatever in it did not come from the repo -- a machine's own settings, or
# ones added since by hand, "git config --global" or tools such as
# "gh auth setup-git" -- to ~/.gitconfig.local, included at the end. Settings
# every machine should have go in the repo copy.

[user]
	name = TimT
	email = tim@toohill.dev
[pull]
	rebase = false
	ff = only
[push]
	default = simple
[credential]
	# In memory only, for seven days: git's cache daemon never writes
	# credentials to disk.
	helper = cache --timeout=604800
[credential "https://github.com"]
	# One login per repository instead of one per host. Without this the
	# cache offers whichever GitHub account logged in last to every repo: a
	# cached work-account login was once sent for a dotfiles push, and
	# GitHub refused it with a 403.
	useHttpPath = true

# Last, so a machine's own settings override everything above. A missing file
# is skipped silently, so machines without one need nothing.
[include]
	path = ~/.gitconfig.local
